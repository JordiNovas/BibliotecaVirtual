@model BibliotecaVirtual.Web.Models.Usuario

@{
    ViewData["Title"] = "Registrar usuario";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Registrar usuario</h1>

        <a asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <strong>No se pudo registrar el usuario.</strong>

                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values
                                .SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Nombre"
                           class="form-label">
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ingrese el nombre completo" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Correo"
                           class="form-label">
                    </label>

                    <input asp-for="Correo"
                           type="email"
                           class="form-control"
                           placeholder="ejemplo@correo.com" />

                    <span asp-validation-for="Correo"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="NombreUsuario"
                           class="form-label">
                    </label>

                    <input asp-for="NombreUsuario"
                           class="form-control"
                           placeholder="Ingrese el nombre de usuario" />

                    <span asp-validation-for="NombreUsuario"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label for="password"
                           class="form-label">
                        Contraseña
                    </label>

                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           minlength="6"
                           placeholder="Ingrese la contraseña"
                           required />

                    @Html.ValidationMessage(
                        "password",
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="alert alert-info">
                    <strong>Rol:</strong> Usuario
                    <br />
                    Este usuario podrá iniciar sesión,
                    consultar libros y realizar préstamos.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Registrar usuario
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}