@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="text-center mb-4">
                        Biblioteca Virtual
                    </h2>

                    <h5 class="text-center mb-4">
                        Iniciar sesión
                    </h5>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Login" method="post">

                        <div class="mb-3">
                            <label class="form-label">
                                Nombre de usuario
                            </label>

                            <input type="text"
                                   name="nombreUsuario"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Contraseña
                            </label>

                            <input type="password"
                                   name="password"
                                   class="form-control"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Iniciar sesión
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div> 