@model IEnumerable<BibliotecaVirtual.Web.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 Catálogo de Libros</h2>
        <a asp-action="MisPrestamos" class="btn btn-outline-primary">Ver Mis Préstamos</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        @foreach (var libro in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-info text-dark mb-2">@libro.Categoria</span>
                        <h5 class="card-title text-truncate">@libro.Titulo</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@libro.Autor</h6>
                        <p class="card-text small text-secondary">ISBN: @(string.IsNullOrEmpty(libro.ISBN) ? "N/A" : libro.ISBN)</p>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center">
                        @if (libro.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                            <form asp-action="Prestar" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@libro.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">Solicitar Préstamo</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Prestado</span>
                            <button class="btn btn-sm btn-outline-secondary" disabled>No Disponible</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>